{% style %}
  /* ==========================================
     FONTS: SEMPLICITAPRO
     ========================================== */

  /* SemplicitaPro Regular (400) */
  @font-face {
    font-family: 'SemplicitaPro';
    src: url("{{ 'SemplicitaPro.woff' | asset_url }}") format('woff'),
         url("{{ 'SemplicitaPro.otf' | asset_url }}") format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* SemplicitaPro Italic (400 Italic) */
  @font-face {
    font-family: 'SemplicitaPro';
    src: url("{{ 'SemplicitaPro-Italic.woff' | asset_url }}") format('woff'),
         url("{{ 'SemplicitaPro-Italic.otf' | asset_url }}") format('opentype');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

