  /* ==========================================
     GLOBAL CSS VARIABLES FOR FONT FAMILIES
     ========================================== */
  :root {
    --font-essonnes: 'EssonnesTest', 'EssonnesTest-Display', serif;
    --font-essonnes-display: 'EssonnesTest-Display', 'EssonnesTest', serif;
    --font-essonnes-headline: 'EssonnesTest-Headline', 'EssonnesTest', serif;
    --font-essonnes-text: 'EssonnesTest-Text', 'EssonnesTest', serif;

    --font-semplicita: 'SemplicitaPro', sans-serif;
    --font-semplicita-bold: 'SemplicitaPro', 'SemplicitaPro-Bold', sans-serif;
    --font-semplicita-light: 'SemplicitaPro', sans-serif;
    --font-semplicita-medium: 'SemplicitaPro', sans-serif;
    --font-semplicita-semibold: 'SemplicitaPro', sans-serif;

    /* Theme-wide Heading & Body font variables */
    --font-custom-heading: var(--font-essonnes-display);
    --font-custom-body: var(--font-semplicita);
  }
