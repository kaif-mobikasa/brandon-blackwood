{{ 'brandon-founder.css' | asset_url | stylesheet_tag }}

{%- style -%}
#ShopifySection-{{ section.id }} .brandon-founder {
padding-top: {{ section.settings.padding_top }}px;
padding-bottom: {{ section.settings.padding_bottom }}px;
background-color: {{ section.settings.bg_color | default: '#ffffff' }};
}
{%- endstyle -%}

<div id="ShopifySection-{{ section.id }}" class="shopify-section brandon-founder-wrapper"
  data-section-id="{{ section.id }}" data-section-type="brandon-founder">
  <section class="brandon-founder" aria-label="{{ section.settings.heading | default: 'THE FOUNDER' | escape }}">
    <div class="brandon-founder__container">

      {%- if section.settings.heading != blank -%}
      <h2 class="brandon-founder__heading">
        {{ section.settings.heading | escape }}
      </h2>
      {%- endif -%}

      <div class="brandon-founder__main-wrapper">

        {%- if section.settings.bg_image_desktop != blank or section.settings.bg_image_mobile != blank -%}
        <picture class="brandon-founder__bg-picture">
          {%- if section.settings.bg_image_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.bg_image_mobile | image_url: width: 1400 }}">
          {%- endif -%}
          {%- if section.settings.bg_image_desktop != blank -%}
          <img src="{{ section.settings.bg_image_desktop | image_url: width: 2400 }}"
            alt="{{ section.settings.heading | escape }}" loading="lazy"
            width="{{ section.settings.bg_image_desktop.width }}"
            height="{{ section.settings.bg_image_desktop.height }}" class="brandon-founder__bg-img">
          {%- else -%}
          <img src="{{ section.settings.bg_image_mobile | image_url: width: 1400 }}"
            alt="{{ section.settings.heading | escape }}" loading="lazy" class="brandon-founder__bg-img">
          {%- endif -%}
        </picture>
        {%- endif -%}

        <div class="brandon-founder__text-box">

          {%- if section.settings.text_bg_image_desktop != blank or section.settings.text_bg_image_mobile != blank -%}
          <picture class="brandon-founder__text-bg-picture">
            {%- if section.settings.text_bg_image_mobile != blank -%}
            <source media="(max-width: 768px)"
              srcset="{{ section.settings.text_bg_image_mobile | image_url: width: 1200 }}">
            {%- endif -%}
            {%- if section.settings.text_bg_image_desktop != blank -%}
            <img src="{{ section.settings.text_bg_image_desktop | image_url: width: 2000 }}" alt="" loading="lazy"
              class="brandon-founder__text-bg-img">
            {%- else -%}
            <img src="{{ section.settings.text_bg_image_mobile | image_url: width: 1200 }}" alt="" loading="lazy"
              class="brandon-founder__text-bg-img">
            {%- endif -%}
          </picture>
          {%- endif -%}

          <div class="brandon-founder__text-content">
            {%- if section.settings.subheading != blank -%}
            <h3 class="brandon-founder__subheading">
              {{ section.settings.subheading | escape }}
            </h3>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
            <div class="brandon-founder__description">
              {{ section.settings.description }}
            </div>
            {%- endif -%}

            {%- if section.settings.bottom_image_desktop != blank -%}
            <div class="brandon-founder__desktop-bottom-img-wrapper">
              <img src="{{ section.settings.bottom_image_desktop | image_url: width: 2000 }}" alt="" loading="lazy"
                width="{{ section.settings.bottom_image_desktop.width }}"
                height="{{ section.settings.bottom_image_desktop.height }}" class="brandon-founder__desktop-bottom-img">
            </div>
            {%- endif -%}
          </div>

        </div>

      </div>

    </div>
  </section>
</div>

{% schema %}
{
"name": "Brandon Founder",
"tag": "section",
"class": "shopify-section-brandon-founder",
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading",
"default": "THE FOUNDER"
},
{
"type": "color",
"id": "bg_color",
"label": "Background Color",
"default": "#ffffff"
},
{
"type": "header",
"content": "Bags Background Image (Picture Tag)"
},
{
"type": "image_picker",
"id": "bg_image_desktop",
"label": "Bags Background Image (Desktop)"
},
{
"type": "image_picker",
"id": "bg_image_mobile",
"label": "Bags Background Image (Mobile)"
},
{
"type": "header",
"content": "Text Container Settings"
},
{
"type": "text",
"id": "subheading",
"label": "Text Subheading",
"default": "ABOUT BRANDON BLACKWOOD"
},
{
"type": "richtext",
"id": "description",
"label": "Description Text"

},
{
"type": "image_picker",
"id": "text_bg_image_desktop",
"label": "Text Box Background Image (Desktop)"
},
{
"type": "image_picker",
"id": "text_bg_image_mobile",
"label": "Text Box Background Image (Mobile)"
},
{
"type": "header",
"content": "Desktop Bottom Image (Desktop Only)"
},
{
"type": "image_picker",
"id": "bottom_image_desktop",
"label": "Bottom Image (Desktop Only)"
},
{
"type": "header",
"content": "Section Padding"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Top Padding",
"default": 40
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 120,
"step": 4,
"unit": "px",
"label": "Bottom Padding",
"default": 60
}
],
"presets": [
{
"name": "Brandon Founder"
}
]
}
{% endschema %}