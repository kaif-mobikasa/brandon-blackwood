{{ 'brandon-product-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'brandon-product-pdp.js' | asset_url }}" defer="defer"></script>

<div id="ShopifySection-{{ section.id }}" class="shopify-section brandon-pdp-wrapper" data-section-id="{{ section.id }}"
  data-section-type="brandon-pdp">
  <section class="brandon-pdp" aria-label="Product Details">
    <div class="brandon-pdp__container">

      <div class="brandon-pdp__gallery-col">
        {%- assign gallery_blocks = section.blocks | where: "type", "gallery_image" -%}
        {%- assign accordion_blocks = section.blocks | where: "type", "accordion" -%}
        {%- assign total_images = 0 -%}
        {%- if gallery_blocks.size > 0 -%}
        {%- assign total_images = gallery_blocks.size -%}
        {%- elsif product.media.size > 0 -%}
        {%- assign total_images = product.media.size -%}
        {%- else -%}
        {%- assign total_images = 6 -%}
        {%- endif -%}

        <div class="brandon-pdp__counter">
          <span class="js-pdp-current-num">01</span>
          <span class="brandon-pdp__counter-dash"></span>
          <span>{% if total_images < 10 %}0{% endif %}{{ total_images }}</span>
        </div>

        <div class="swiper brandon-pdp__swiper js-pdp-swiper">
          <div class="swiper-wrapper brandon-pdp__gallery-list js-pdp-gallery-list">
            {%- if gallery_blocks.size > 0 -%}
            {%- for block in gallery_blocks -%}
            <div class="swiper-slide brandon-pdp__gallery-item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ product.title | escape }}"
                loading="lazy" class="brandon-pdp__gallery-img">
              {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg brandon-pdp__gallery-img' }}
              {%- endif -%}
            </div>
            {%- endfor -%}
            {%- elsif product.media.size > 0 -%}
            {%- for media in product.media -%}
            <div class="swiper-slide brandon-pdp__gallery-item">
              <img src="{{ media | image_url: width: 1800 }}" alt="{{ product.title | escape }}" loading="lazy"
                class="brandon-pdp__gallery-img">
            </div>
            {%- endfor -%}
            {%- else -%}
            {%- for i in (1..6) -%}
            <div class="swiper-slide brandon-pdp__gallery-item">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg brandon-pdp__gallery-img' }}
            </div>
            {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <div class="brandon-pdp__mobile-controls">
          <button type="button" class="brandon-pdp__mobile-nav-btn js-pdp-prev" aria-label="Previous image">
          <svg width="33" height="12" viewBox="0 0 33 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0.68214 6.67971H32.3197C32.6961 6.67971 33.0001 6.37442 33.0001 5.99653C33.0001 5.61865 32.6961 5.31335 32.3197 5.31335H2.32568L6.45472 1.16728C6.7205 0.900413 6.7205 0.46702 6.45472 0.200151C6.18895 -0.0667171 5.75734 -0.0667171 5.49156 0.200151L0.199497 5.51403C0.00388718 5.71045 -0.0535202 6.00294 0.0527916 6.25913C0.1591 6.51319 0.407864 6.67971 0.68214 6.67971Z" fill="black"/>
<path d="M5.98041 12.0008C6.15476 12.0008 6.32911 11.9346 6.46093 11.8001C6.72671 11.5332 6.72671 11.0998 6.46093 10.8329L1.16249 5.51265C0.896714 5.24578 0.465101 5.24578 0.199328 5.51265C-0.0664449 5.77952 -0.0664449 6.21291 0.199328 6.47978L5.49777 11.8001C5.63172 11.9346 5.80607 12.0008 5.98041 12.0008Z" fill="black"/>
</svg>

          </button>

          <div class="brandon-pdp__mobile-dots js-pdp-dots"></div>

          <button type="button" class="brandon-pdp__mobile-nav-btn js-pdp-next" aria-label="Next image">
           <svg width="33" height="12" viewBox="0 0 33 12" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M32.318 6.67971H0.680378C0.304044 6.67971 0 6.37442 0 5.99653C0 5.61865 0.304044 5.31335 0.680378 5.31335H30.6744L26.5454 1.16728C26.2796 0.900413 26.2796 0.46702 26.5454 0.200151C26.8112 -0.0667171 27.2428 -0.0667171 27.5085 0.200151L32.8006 5.51403C32.9962 5.71045 33.0536 6.00294 32.9473 6.25913C32.841 6.51319 32.5922 6.67971 32.318 6.67971Z" fill="black"/>
<path d="M27.0197 12.0008C26.8453 12.0008 26.671 11.9346 26.5392 11.8001C26.2734 11.5332 26.2734 11.0998 26.5392 10.8329L31.8376 5.51265C32.1034 5.24578 32.535 5.24578 32.8008 5.51265C33.0666 5.77952 33.0666 6.21291 32.8008 6.47978L27.5023 11.8001C27.3684 11.9346 27.194 12.0008 27.0197 12.0008Z" fill="black"/>
</svg>

          </button>
        </div>
      </div>

      <div class="brandon-pdp__info-col">
        <div class="brandon-pdp__header-wrapper">
          <h1 class="brandon-pdp__title">
            {{ product.title | default: section.settings.fallback_title | default: 'Luna Bag' }}
          </h1>

          {%- if section.settings.badge_text != blank -%}
          <span class="brandon-pdp__badge">
            {{ section.settings.badge_text | escape }}
          </span>
          {%- endif -%}
        </div>

        <div class="brandon-pdp__price-row">
          <span class="brandon-pdp__price">
            {{ product.price | default: 69000 | money }}
          </span>
          {%- if product.compare_at_price > product.price or section.settings.fallback_compare_price != blank -%}
          <span class="brandon-pdp__price--compare">
            {{ product.compare_at_price | default: section.settings.fallback_compare_price | money }}
          </span>
          {%- endif -%}
        </div>

        {%- if section.settings.selected_color != blank -%}
        <div class="brandon-pdp__color-label-row">
          <div>
            <span>Color: </span>
            <span class="brandon-pdp__color-name">{{ section.settings.selected_color | escape }}</span>
          </div>
        </div>
        {%- endif -%}

        <div class="brandon-pdp__swatches-row">
          <div class="brandon-pdp__swatches">
            <span class="brandon-pdp__swatch brandon-pdp__swatch--active" style="background-color: #d2b48c;"></span>
            <span class="brandon-pdp__swatch" style="background-color: #3b3c36;"></span>
            <span class="brandon-pdp__swatch" style="background-color: #8b5a2b;"></span>
            <span class="brandon-pdp__swatch" style="background-color: #c5a059;"></span>
            <span class="brandon-pdp__swatch-more">+3</span>
          </div>
          {%- if section.settings.view_other_colors_link != blank -%}
          <a href="{{ section.settings.view_other_colors_link }}" class="brandon-pdp__other-colors-link"
            aria-label="View other colors">
            {{ section.settings.other_colors_text | default: 'View other colors' | escape }}
          </a>
          {%- else -%}
          <a href="#" class="brandon-pdp__other-colors-link" aria-label="View other colors">
            {{ section.settings.other_colors_text | default: 'View other colors' | escape }}
          </a>
          {%- endif -%}
        </div>

        {%- form 'product', product, id: 'BrandonPdpForm', class: 'brandon-pdp__form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="brandon-pdp__atc-btn"
          aria-label="Add {{ product.title | default: 'Luna Bag' | escape }} to cart">
