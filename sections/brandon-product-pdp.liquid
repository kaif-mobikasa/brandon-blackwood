                              {%- if comp_icon_str contains '<svg' or item.icon contains '<svg' -%}
                                <span class="brandon-pdp__composition-icon-wrap">{{ item.icon }}</span>
                              {%- else -%}
                                <img src="{{ item.icon | image_url: width: 80 }}" alt="{{ item.title | escape }}" class="brandon-pdp__composition-icon" loading="lazy">
                              {%- endif -%}
                            {%- endif -%}
                            <div class="brandon-pdp__composition-divider"></div>
                          </div>
                          <div class="brandon-pdp__composition-info">
                            <span class="brandon-pdp__composition-title">{{ item.title }}</span>
                            <span class="brandon-pdp__composition-material">{{ item.material }}</span>
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- elsif block.settings.use_product_description -%}
                    {{ product.description | default: section.settings.fallback_description }}
                  {%- elsif block.settings.page_content != blank -%}
                    {{ block.settings.page_content.content }}
                  {%- elsif block.settings.content != blank -%}
                    {{ block.settings.content }}
                  {%- else -%}
                    <p>Details for {{ block.settings.heading | escape }}.</p>
                  {%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          {%- else -%}
