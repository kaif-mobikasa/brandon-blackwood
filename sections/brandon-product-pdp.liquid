            <span>{{ section.settings.all_details_text | default: 'All Details' | escape }}</span>
          </button>

          <a href="{{ section.settings.personalize_link | default: '#' }}" class="brandon-pdp__action-link"
            aria-label="{{ section.settings.personalize_text | default: 'Personalize' | escape }} {{ product.title | default: 'Luna Bag' | escape }}">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.5 1.5L10.5 3.5L3.5 10.5H1.5V8.5L8.5 1.5Z" stroke="#111111" stroke-width="1.2"
                stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{{ section.settings.personalize_text | default: 'Personalize' | escape }}</span>
          </a>
        </div>

        {%- assign product_details = product.metafields.custom.product_details.value -%}
        {%- assign item_details = product.metafields.custom.item_details.value -%}
        {%- assign composition = product.metafields.custom.composition.value -%}

        <div class="brandon-pdp__accordions js-pdp-accordions" id="details">
          {%- if accordion_blocks.size > 0 -%}
            {%- for block in accordion_blocks -%}
              {%- assign heading_lower = block.settings.heading | downcase -%}
              <details class="brandon-pdp__accordion" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="brandon-pdp__accordion-header">
                  <span>{{ block.settings.heading | escape }}</span>
                  <span class="brandon-pdp__accordion-icon">+</span>
                </summary>
                <div class="brandon-pdp__accordion-content">
                  {%- if heading_lower contains 'product' -%}
                    {%- if product_details != blank -%}
                      <div class="brandon-pdp__product-details-content">
                        {%- assign features_list = product_details.features.value | default: product_details.features -%}
                        {%- if features_list != blank -%}
                          {%- assign features_array = features_list -%}
                          {%- if features_list.first == blank and features_list != blank -%}
                            {%- assign features_array = features_list | newline_to_br | split: '<br />' -%}
                          {%- endif -%}
                          <ul class="brandon-pdp__features-list">
                            {%- for feature in features_array -%}
                              {%- assign f_clean = feature | strip -%}
                              {%- if f_clean != blank -%}
                                <li>{{ f_clean }}</li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                        {%- if product_details.reference_number != blank -%}
                          <p class="brandon-pdp__meta-line">Reference Number: {{ product_details.reference_number }}</p>
                        {%- endif -%}
                        {%- if product_details.designed_in != blank -%}
                          <p class="brandon-pdp__meta-line">Designed in {{ product_details.designed_in }}</p>
                        {%- endif -%}
                        {%- if product_details.questions_text != blank or product_details.contact_email != blank -%}
