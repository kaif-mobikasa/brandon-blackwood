                    {%- endif -%}
                    {%- if product_details.designed_in != blank -%}
                      <p class="brandon-pdp__meta-line">Designed in {{ product_details.designed_in }}</p>
                    {%- endif -%}
                    {%- if product_details.questions_text != blank or product_details.contact_email != blank -%}
