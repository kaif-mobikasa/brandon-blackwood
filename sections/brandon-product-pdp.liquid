                    {{ block.settings.content }}
                  {%- else -%}
                    <p>Details for {{ block.settings.heading | escape }}.</p>
                  {%- endif -%}
                </div>
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            <div class="brandon-pdp__desktop-tab-panel js-pdp-tab-panel is-active" id="tab-desc">
              {{ product.description | default: section.settings.fallback_description }}
            </div>
            <div class="brandon-pdp__desktop-tab-panel js-pdp-tab-panel" id="tab-product">
              {%- if product_details != blank -%}
                <div class="brandon-pdp__product-details-content">
                  {%- assign features_list = product_details.features.value | default: product_details.features -%}
                  {%- if features_list != blank -%}
                    {%- assign features_array = features_list -%}
                    {%- if features_list.first == blank and features_list != blank -%}
                      {%- assign features_array = features_list | newline_to_br | split: '<br />' -%}
                    {%- endif -%}
                    <ul class="brandon-pdp__features-list">
                      {%- for feature in features_array -%}
                        {%- assign f_clean = feature | strip -%}
                        {%- if f_clean != blank -%}
                          <li>{{ f_clean }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if product_details.reference_number != blank -%}
                    <p class="brandon-pdp__meta-line">Reference Number: {{ product_details.reference_number }}</p>
                  {%- endif -%}
                  {%- if product_details.designed_in != blank -%}
                    <p class="brandon-pdp__meta-line">Designed in {{ product_details.designed_in }}</p>
                  {%- endif -%}
                  {%- if product_details.questions_text != blank or product_details.contact_email != blank -%}
                    <div class="brandon-pdp__meta-questions">
                      {%- if product_details.questions_text != blank -%}
                        <p>{{ product_details.questions_text }}</p>
                      {%- endif -%}
                      {%- if product_details.contact_email != blank -%}
                        <p>Reach out to us at <a href="mailto:{{ product_details.contact_email }}">{{ product_details.contact_email }}</a>.</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
            <div class="brandon-pdp__desktop-tab-panel js-pdp-tab-panel" id="tab-item">
              <div class="brandon-pdp__item-details-list">
                {%- for item in item_details -%}
                  <div class="brandon-pdp__item-detail-row">
                    <div class="brandon-pdp__item-detail-label">
                      {%- if item.icon != blank -%}
                        {%- assign item_icon_str = item.icon | string -%}
                        {%- if item_icon_str contains '<svg' or item.icon contains '<svg' -%}
                          <span class="brandon-pdp__detail-icon-wrap">{{ item.icon }}</span>
                        {%- else -%}
                          <img src="{{ item.icon | image_url: width: 60 }}" alt="{{ item.label | escape }}" class="brandon-pdp__detail-icon" loading="lazy">
                        {%- endif -%}
                      {%- endif -%}
                      <span>{{ item.label }}</span>
                    </div>
                    <div class="brandon-pdp__item-detail-value">
                      {{ item.value }}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
            <div class="brandon-pdp__desktop-tab-panel js-pdp-tab-panel" id="tab-comp">
              <div class="brandon-pdp__composition-list">
                {%- for item in composition -%}
                  <div class="brandon-pdp__composition-row">
                    <div class="brandon-pdp__composition-icon-wrap">
                      {%- if item.icon != blank -%}
                        {%- assign comp_icon_str = item.icon | string -%}
                        {%- if comp_icon_str contains '<svg' or item.icon contains '<svg' -%}
                          <span class="brandon-pdp__composition-icon-wrap">{{ item.icon }}</span>
                        {%- else -%}
                          <img src="{{ item.icon | image_url: width: 80 }}" alt="{{ item.title | escape }}" class="brandon-pdp__composition-icon" loading="lazy">
                        {%- endif -%}
                      {%- endif -%}
                      <div class="brandon-pdp__composition-divider"></div>
                    </div>
                    <div class="brandon-pdp__composition-info">
                      <span class="brandon-pdp__composition-title">{{ item.title }}</span>
                      <span class="brandon-pdp__composition-material">{{ item.material }}</span>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </section>

  <div class="brandon-pdp__sticky-atc js-pdp-sticky-atc" aria-label="Sticky Add to Cart">
    <div class="brandon-pdp__sticky-atc-inner">
      <div class="brandon-pdp__sticky-atc-left">
        <div class="brandon-pdp__sticky-atc-media">
          {%- if product.featured_media != blank -%}
          <img src="{{ product.featured_media | image_url: width: 200 }}" alt="{{ product.title | escape }}" class="brandon-pdp__sticky-atc-img" loading="lazy">
          {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg brandon-pdp__sticky-atc-img' }}
          {%- endif -%}
        </div>
        <div class="brandon-pdp__sticky-atc-info">
          <span class="brandon-pdp__sticky-atc-title">{{ product.title | default: 'Luna Bag' }}</span>
          {%- if product.has_only_default_variant == false and product.variants.size > 1 -%}
          <div class="brandon-pdp__sticky-atc-variant-wrap">
            <select class="brandon-pdp__sticky-atc-select js-sticky-variant-select" aria-label="Select Variant">
              {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %} data-price="{{ variant.price | money }}" data-inventory="{{ variant.inventory_quantity }}">
                {{ variant.title }}
              </option>
              {%- endfor -%}
            </select>
            <span class="brandon-pdp__sticky-atc-caret" aria-hidden="true">
             <svg width="8" height="4" viewBox="0 0 8 4" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4 4L8 0H0L4 4Z" fill="#727272"/>
</svg>

            </span>
          </div>
          {%- else -%}
          <span class="brandon-pdp__sticky-atc-variant-name">
            {{ product.selected_or_first_available_variant.title | default: 'Fringed Wicker' }}
           <svg width="8" height="4" viewBox="0 0 8 4" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M4 4L8 0H0L4 4Z" fill="#727272"/>
</svg>

          </span>
          {%- endif -%}
        </div>
      </div>

      <div class="brandon-pdp__sticky-atc-middle">
        <div class="brandon-pdp__sticky-atc-price js-sticky-price">
          {{ product.selected_or_first_available_variant.price | default: product.price | money | default: '$690.00' }}
        </div>
        <div class="brandon-pdp__sticky-atc-stock js-sticky-stock">
          {%- assign current_var = product.selected_or_first_available_variant -%}
          {%- if current_var.inventory_quantity > 0 and current_var.inventory_quantity <= 10 -%}
          Only {{ current_var.inventory_quantity }} left
          {%- else -%}
          Only 3 left
          {%- endif -%}
        </div>
      </div>

      <div class="brandon-pdp__sticky-atc-right">
        {%- form 'product', product, class: 'brandon-pdp__sticky-form js-sticky-form' -%}
        <input type="hidden" name="id" class="js-sticky-variant-id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="brandon-pdp__sticky-atc-btn">
