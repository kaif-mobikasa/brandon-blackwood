                        </div>
                      {%- endfor -%}
                    </div>
                  {%- elsif heading_downcase contains 'composition' -%}
                    <div class="brandon-pdp__composition-list">
                      {%- for item in composition -%}
                        <div class="brandon-pdp__composition-row">
                          <div class="brandon-pdp__composition-icon-wrap">
