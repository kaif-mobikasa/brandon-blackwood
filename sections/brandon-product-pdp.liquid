                        {%- if product_details.questions_text != blank -%}
                          <p>{{ product_details.questions_text }}</p>
                        {%- endif -%}
                        {%- if product_details.contact_email != blank -%}
                          <p>Reach out to us at <a href="mailto:{{ product_details.contact_email }}">{{ product_details.contact_email }}</a>.</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </details>

            <details class="brandon-pdp__accordion">
              <summary class="brandon-pdp__accordion-header">
                <span>Item Details</span>
                <span class="brandon-pdp__accordion-icon">+</span>
              </summary>
              <div class="brandon-pdp__accordion-content">
                <div class="brandon-pdp__item-details-list">
                  {%- for item in item_details -%}
                    <div class="brandon-pdp__item-detail-row">
                      <div class="brandon-pdp__item-detail-label">
                        {%- if item.icon != blank -%}
                          {%- assign item_icon_str = item.icon | string -%}
                          {%- if item_icon_str contains '<svg' or item.icon contains '<svg' -%}
                            <span class="brandon-pdp__detail-icon-wrap">{{ item.icon }}</span>
                          {%- else -%}
                            <img src="{{ item.icon | image_url: width: 60 }}" alt="{{ item.label | escape }}" class="brandon-pdp__detail-icon" loading="lazy">
                          {%- endif -%}
                        {%- endif -%}
                        <span>{{ item.label }}</span>
                      </div>
                      <div class="brandon-pdp__item-detail-value">
                        {{ item.value }}
