{{ 'brandon-art-of-materials.css' | asset_url | stylesheet_tag }}

{%- style -%}
#ShopifySection-{{ section.id }} .brandon-art-materials {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg_color | default: '#ffffff' }};
}
{%- endstyle -%}

<div id="ShopifySection-{{ section.id }}" class="shopify-section brandon-art-materials-wrapper" data-section-id="{{ section.id }}" data-section-type="brandon-art-of-materials">
  <section class="brandon-art-materials" aria-label="The Art of Uncommon Materials">
    <div class="brandon-art-materials__container">
      <div class="brandon-art-materials__media">
        {%- if section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
          <picture class="brandon-art-materials__picture">
            {%- if section.settings.image_mobile != blank -%}
              <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
            {%- endif -%}
            {%- if section.settings.image_desktop != blank -%}
              <img src="{{ section.settings.image_desktop | image_url: width: 1400 }}" alt="{{ section.settings.heading | default: 'The Art of Uncommon Materials' | escape }}" loading="lazy" class="brandon-art-materials__img">
            {%- else -%}
              <img src="{{ section.settings.image_mobile | image_url: width: 1000 }}" alt="{{ section.settings.heading | default: 'The Art of Uncommon Materials' | escape }}" loading="lazy" class="brandon-art-materials__img">
            {%- endif -%}
          </picture>
        {%- else -%}
          <div class="brandon-art-materials__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
      <div class="brandon-art-materials__content">
        <div class="brandon-art-materials__content-inner">
          {%- if section.settings.heading != blank -%}
            <h2 class="brandon-art-materials__heading">
              {{ section.settings.heading | newline_to_br }}
            </h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="brandon-art-materials__desc">
              {{ section.settings.description | newline_to_br }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: '#' }}" class="brandon-art-materials__link">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </section>
</div>

{% schema %}
{
  "name": "Art of Uncommon Materials",
  "tag": "section",
  "class": "shopify-section-brandon-art-materials",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section Heading",
      "default": "THE ART OF UNCOMMON MATERIALS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At Brandon Blackwood, we believe true luxury lies in the details. Our Uncommon Materials Collection showcases unique textures and rare finishes, selected and crafted to create timeless, unforgettable handbags."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button / Link Label",
      "default": "READ MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button / Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Art of Uncommon Materials"
    }
  ]
}
{% endschema %}
