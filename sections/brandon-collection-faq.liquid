{{ 'brandon-collection-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'brandon-collection-faq.js' | asset_url }}" defer="defer"></script>

{%- assign collection_faqs = collection.metafields.custom.collection_faqs.value -%}

{%- if collection_faqs != blank and collection_faqs.size > 0 -%}
  {%- style -%}
  #ShopifySection-{{ section.id }} .brandon-collection-faq {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color | default: '#f4f4f4' }};
  }
  {%- endstyle -%}

  <div id="ShopifySection-{{ section.id }}" class="shopify-section brandon-collection-faq-wrapper" data-section-id="{{ section.id }}" data-section-type="brandon-collection-faq">
    <section class="brandon-collection-faq" aria-label="{{ section.settings.heading}}">
      <div class="brandon-collection-faq__container">
        
        {%- if section.settings.heading != blank -%}
          <div class="brandon-collection-faq__header">
            <h2 class="brandon-collection-faq__heading">
              {{ section.settings.heading }}
            </h2>
          </div>
        {%- endif -%}

        <div class="brandon-collection-faq__accordion js-faq-accordion">
          {%- for faq in collection_faqs -%}
            {%- assign faq_heading = faq.faq_heading.value -%}
            {%- assign faq_answer = faq.faq_answer -%}

            {%- if faq_heading != blank -%}
              <details class="brandon-collection-faq__item js-faq-item">
                <summary class="brandon-collection-faq__summary js-faq-summary">
                  <span class="brandon-collection-faq__title">{{ faq_heading }}</span>
                  <span class="brandon-collection-faq__icon" aria-hidden="true">
                    <svg class="brandon-collection-faq__icon-chevron" width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1 1L6 6L11 1" stroke="#1B1B1B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <svg class="brandon-collection-faq__icon-plus" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M7 1V13M1 7H13" stroke="#1B1B1B" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </span>
                </summary>
                
                <div class="brandon-collection-faq__answer js-faq-answer">
                  <div class="brandon-collection-faq__answer-inner">
                    {%- if faq_answer != blank -%}
                      {{ faq_answer | metafield_tag }}
                    {%- endif -%}
                  </div>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>
    </section>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection FAQ Accordion",
  "tag": "section",
  "class": "shopify-section-brandon-collection-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Collection FAQ Accordion"
    }
  ]
}
{% endschema %}
