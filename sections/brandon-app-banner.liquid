{{ 'brandon-app-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ShopifySection-{{ section.id }} .brandon-app-banner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div
  id="ShopifySection-{{ section.id }}"
  class="shopify-section brandon-app-banner-wrapper"
  data-section-id="{{ section.id }}"
  data-section-type="brandon-app-banner"
>
  <section class="brandon-app-banner" aria-label="{{ section.settings.subheading | default: 'THE BRANDON BLACKWOOD APP' | escape }}">
    
    {%- if section.settings.show_marquee -%}
      <div class="brandon-app-banner__marquee-strip">
        <div class="brandon-app-banner__marquee-track">
          {%- for i in (1..3) -%}
            <div class="brandon-app-banner__marquee-group">
              <span class="brandon-app-banner__marquee-item">{{ section.settings.marquee_text_1 | default: 'APP-ONLY DROPS' | escape }}</span>
              {%- if section.settings.marquee_icon_svg != blank or section.settings.marquee_icon_image != blank -%}
                <span class="brandon-app-banner__marquee-icon">
                  {%- if section.settings.marquee_icon_svg != blank -%}
                    {{ section.settings.marquee_icon_svg }}
                  {%- elsif section.settings.marquee_icon_image != blank -%}
                    <img src="{{ section.settings.marquee_icon_image | image_url: width: 40 }}" alt="" loading="lazy">
                  {%- endif -%}
                </span>
              {%- endif -%}

              <span class="brandon-app-banner__marquee-item">{{ section.settings.marquee_text_2 | default: 'EARLY ACCESS TO LAUNCHES' | escape }}</span>
              {%- if section.settings.marquee_icon_svg != blank or section.settings.marquee_icon_image != blank -%}
                <span class="brandon-app-banner__marquee-icon">
                  {%- if section.settings.marquee_icon_svg != blank -%}
                    {{ section.settings.marquee_icon_svg }}
                  {%- elsif section.settings.marquee_icon_image != blank -%}
                    <img src="{{ section.settings.marquee_icon_image | image_url: width: 40 }}" alt="" loading="lazy">
                  {%- endif -%}
                </span>
              {%- endif -%}

              <span class="brandon-app-banner__marquee-item">{{ section.settings.marquee_text_3 | default: 'MEMBERS SHOP FIRST' | escape }}</span>
              {%- if section.settings.marquee_icon_svg != blank or section.settings.marquee_icon_image != blank -%}
                <span class="brandon-app-banner__marquee-icon">
                  {%- if section.settings.marquee_icon_svg != blank -%}
                    {{ section.settings.marquee_icon_svg }}
                  {%- elsif section.settings.marquee_icon_image != blank -%}
                    <img src="{{ section.settings.marquee_icon_image | image_url: width: 40 }}" alt="" loading="lazy">
                  {%- endif -%}
                </span>
              {%- endif -%}

              <span class="brandon-app-banner__marquee-item">{{ section.settings.marquee_text_4 | default: 'INSTANT DROP ALERTS' | escape }}</span>
              {%- if section.settings.marquee_icon_svg != blank or section.settings.marquee_icon_image != blank -%}
                <span class="brandon-app-banner__marquee-icon">
                  {%- if section.settings.marquee_icon_svg != blank -%}
                    {{ section.settings.marquee_icon_svg }}
                  {%- elsif section.settings.marquee_icon_image != blank -%}
                    <img src="{{ section.settings.marquee_icon_image | image_url: width: 40 }}" alt="" loading="lazy">
                  {%- endif -%}
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="brandon-app-banner__main-wrapper">
      {%- if section.settings.bg_image_desktop != blank or section.settings.bg_image_mobile != blank -%}
        <picture class="brandon-app-banner__bg-picture">
          {%- if section.settings.bg_image_mobile != blank -%}
            <source
              media="(max-width: 768px)"
              srcset="{{ section.settings.bg_image_mobile | image_url: width: 1400 }}"
            >
          {%- endif -%}
          {%- if section.settings.bg_image_desktop != blank -%}
            <img
              src="{{ section.settings.bg_image_desktop | image_url: width: 2800 }}"
              alt="{{ section.settings.subheading | escape }}"
              loading="lazy"
              width="{{ section.settings.bg_image_desktop.width }}"
              height="{{ section.settings.bg_image_desktop.height }}"
              class="brandon-app-banner__bg-img"
            >
          {%- else -%}
            <img
              src="{{ section.settings.bg_image_mobile | image_url: width: 1400 }}"
              alt="{{ section.settings.subheading | escape }}"
              loading="lazy"
              class="brandon-app-banner__bg-img"
            >
          {%- endif -%}
        </picture>
      {%- endif -%}

      <div class="brandon-app-banner__container">
        <div class="brandon-app-banner__content">
          {%- if section.settings.subheading != blank -%}
            <div class="brandon-app-banner__subheading">
              {{ section.settings.subheading | escape }}
            </div>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="brandon-app-banner__heading">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

          <div class="brandon-app-banner__buttons brandon-app-banner__buttons--desktop">
            {%- if section.settings.app_store_svg_desktop != blank -%}
              <a href="{{ section.settings.app_store_url | default: '#' }}" class="brandon-app-banner__btn-svg" aria-label="Download on the App Store">
                {{ section.settings.app_store_svg_desktop }}
              </a>
            {%- endif -%}

            {%- if section.settings.google_play_svg_desktop != blank -%}
              <a href="{{ section.settings.google_play_url | default: '#' }}" class="brandon-app-banner__btn-svg" aria-label="Get it on Google Play">
                {{ section.settings.google_play_svg_desktop }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <div class="brandon-app-banner__bottom-bar brandon-app-banner__bottom-bar--mobile">
      <div class="brandon-app-banner__buttons brandon-app-banner__buttons--mobile">
        {%- assign app_store_mobile_svg = section.settings.app_store_svg_mobile | default: section.settings.app_store_svg_desktop -%}
        {%- if app_store_mobile_svg != blank -%}
          <a href="{{ section.settings.app_store_url | default: '#' }}" class="brandon-app-banner__btn-svg" aria-label="Download on the App Store">
            {{ app_store_mobile_svg }}
          </a>
        {%- endif -%}

        {%- assign google_play_mobile_svg = section.settings.google_play_svg_mobile | default: section.settings.google_play_svg_desktop -%}
        {%- if google_play_mobile_svg != blank -%}
          <a href="{{ section.settings.google_play_url | default: '#' }}" class="brandon-app-banner__btn-svg" aria-label="Get it on Google Play">
            {{ google_play_mobile_svg }}
          </a>
        {%- endif -%}
      </div>
    </div>

  </section>
</div>

{% schema %}
{
  "name": "Brandon App Banner",
  "tag": "section",
  "class": "shopify-section-brandon-app-banner",
  "settings": [
    {
      "type": "header",
      "content": "Top Marquee Strip Settings"
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Show Top Marquee Strip",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text_1",
      "label": "Marquee Item 1",
      "default": "APP-ONLY DROPS"
    },
    {
      "type": "text",
      "id": "marquee_text_2",
      "label": "Marquee Item 2",
      "default": "EARLY ACCESS TO LAUNCHES"
    },
    {
      "type": "text",
      "id": "marquee_text_3",
      "label": "Marquee Item 3",
      "default": "MEMBERS SHOP FIRST"
    },
    {
      "type": "text",
      "id": "marquee_text_4",
      "label": "Marquee Item 4",
      "default": "INSTANT DROP ALERTS"
    },
    {
      "type": "html",
      "id": "marquee_icon_svg",
      "label": "Marquee Icon SVG Code (Optional)"
    },
    {
      "type": "image_picker",
      "id": "marquee_icon_image",
      "label": "Marquee Icon Image (Optional)"
    },
    {
      "type": "header",
      "content": "Background Image Settings"
    },
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "header",
      "content": "Text Content Settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "THE BRANDON BLACKWOOD APP"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading (HTML allowed)",
      "default": "THE DROP, <br><span class=\"brandon-app-banner__em-wrapper\"><em>BEFORE</em></span> THE DROP."
    },
    {
      "type": "header",
      "content": "App Store Button SVG Settings"
    },
    {
      "type": "url",
      "id": "app_store_url",
      "label": "App Store Link"
    },
    {
      "type": "html",
      "id": "app_store_svg_desktop",
      "label": "App Store Custom SVG Code (Desktop)"
    },
    {
      "type": "html",
      "id": "app_store_svg_mobile",
      "label": "App Store Custom SVG Code (Mobile)"
    },
    {
      "type": "header",
      "content": "Google Play Button SVG Settings"
    },
    {
      "type": "url",
      "id": "google_play_url",
      "label": "Google Play Link"
    },
    {
      "type": "html",
      "id": "google_play_svg_desktop",
      "label": "Google Play Custom SVG Code (Desktop)"
    },
    {
      "type": "html",
      "id": "google_play_svg_mobile",
      "label": "Google Play Custom SVG Code (Mobile)"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brandon App Banner"
    }
  ]
}
{% endschema %}
