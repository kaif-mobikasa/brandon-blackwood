},
{
"type": "color",
"id": "color_1",
"label": "Color Swatch 1",
"default": "#b58359"
},
{
"type": "color",
"id": "color_2",
"label": "Color Swatch 2",
"default": "#cc6666"
},
{
"type": "color",
