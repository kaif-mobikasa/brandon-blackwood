{{ 'brandon-hero-banner.css' | asset_url | stylesheet_tag }}

<div id="ShopifySection-{{ section.id }}" class="shopify-section brandon-hero-section-wrapper"
  data-section-id="{{ section.id }}" data-section-type="brandon-hero"
  data-loading-duration="{{ section.settings.loading_duration | default: 2.2 }}"
  data-zoom-scale="{{ section.settings.zoom_scale | default: 1.3 }}">
  <section class="brandon-hero-section" aria-label="Hero Banner">

    {%- comment -%} 0. SPLIT SCREEN LOADING OVERLAY {%- endcomment -%}
    {%- if section.settings.show_loading_screen -%}
    <div class="brandon-hero__loader" id="BrandonHeroLoader-{{ section.id }}">
      <!-- Top Split Panel -->
      <div class="brandon-hero__loader-panel brandon-hero__loader-panel--top">
        {%- if section.settings.loading_top_image != blank -%}
        <img src="{{ section.settings.loading_top_image | image_url: width: 2400 }}" alt=""
          class="brandon-hero__loader-bg-img" loading="eager">
        {%- elsif section.settings.desktop_banner_image != blank -%}
        <img src="{{ section.settings.desktop_banner_image | image_url: width: 2400 }}" alt=""
          class="brandon-hero__loader-bg-img" loading="eager">
        {%- endif -%}
        <div class="brandon-hero__loader-b brandon-hero__loader-b--top">
          {%- if section.settings.loading_logo_text != blank -%}
          <span>{{ section.settings.loading_logo_text | slice: 0, 1 }}</span>
          {%- else -%}
          <span>B</span>
          {%- endif -%}
        </div>
      </div>

      <!-- Bottom Split Panel -->
      <div class="brandon-hero__loader-panel brandon-hero__loader-panel--bottom">
        {%- if section.settings.loading_bottom_image != blank -%}
        <img src="{{ section.settings.loading_bottom_image | image_url: width: 2400 }}" alt=""
          class="brandon-hero__loader-bg-img" loading="eager">
        {%- elsif section.settings.desktop_banner_image != blank -%}
        <img src="{{ section.settings.desktop_banner_image | image_url: width: 2400 }}" alt=""
          class="brandon-hero__loader-bg-img" loading="eager">
        {%- endif -%}
        <div class="brandon-hero__loader-b brandon-hero__loader-b--bottom">
          {%- if section.settings.loading_logo_text != blank -%}
          <span>{{ section.settings.loading_logo_text | slice: 0, 1 }}</span>
          {%- else -%}
          <span>B</span>
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} BANNER MEDIA (<picture> ELEMENT) {%- endcomment -%}
      <div class="brandon-hero__media-wrapper">


        <picture class="brandon-hero__picture brandon-hero__picture--base">
          {%- if section.settings.mobile_banner_image != blank -%}
          <source media="(max-width: 767px)"
            srcset="{{ section.settings.mobile_banner_image | image_url: width: 1500 }}">
          {%- endif -%}

          {%- if section.settings.desktop_banner_image != blank -%}
          <img src="{{ section.settings.desktop_banner_image | image_url: width: 2400 }}"
            alt="{{ section.settings.banner_image_alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.desktop_banner_image.width }}"
            height="{{ section.settings.desktop_banner_image.height }}" loading="lazy" class="brandon-hero__image">
          {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg brandon-hero__image' }}
          {%- endif -%}
        </picture>

        {%- if section.settings.zoomed_desktop_banner_image != blank -%}
        <picture class="brandon-hero__picture brandon-hero__picture--zoomed">
          {%- if section.settings.zoomed_mobile_banner_image != blank -%}
          <source media="(max-width: 767px)"
            srcset="{{ section.settings.zoomed_mobile_banner_image | image_url: width: 1500 }}">
          {%- elsif section.settings.mobile_banner_image != blank -%}
          <source media="(max-width: 767px)"
            srcset="{{ section.settings.mobile_banner_image | image_url: width: 1500 }}">
          {%- endif -%}

          <img src="{{ section.settings.zoomed_desktop_banner_image | image_url: width: 2400 }}"
            alt="{{ section.settings.banner_image_alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.zoomed_desktop_banner_image.width }}"
            height="{{ section.settings.zoomed_desktop_banner_image.height }}" loading="lazy"
            class="brandon-hero__image brandon-hero__image--zoomed">
        </picture>
        {%- endif -%}

        {%- comment -%} GLASSMOPHIC PREVIEW NOW CONTENT OVERLAY {%- endcomment -%}
        <div class="brandon-hero__content-overlay">
          <div class="brandon-hero__glass-card">
            <div class="brandon-hero__subheading">
              {{ section.settings.subheading }}
            </div>

            <h1 class="brandon-hero__title">
              {{ section.settings.heading }}
            </h1>

            <a href="{{ section.settings.button_link | default: '#' }}"
              class="brandon-hero__btn brandon-hero__btn--pill">
              {{ section.settings.button_label}}
            </a>
          </div>

          {%- if section.settings.show_scroll_arrow -%}
          <div class="brandon-hero__scroll-arrow" aria-label="Scroll Down">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M21.7067 10.2924C21.7997 10.3853 21.8735 10.4956 21.9238 10.617C21.9741 10.7384 22 10.8685 22 10.9999C22 11.1313 21.9741 11.2614 21.9238 11.3828C21.8735 11.5042 21.7997 11.6145 21.7067 11.7073L11.7073 21.7067C11.6145 21.7997 11.5042 21.8735 11.3828 21.9238C11.2614 21.9741 11.1313 22 10.9999 22C10.8685 22 10.7384 21.9741 10.617 21.9238C10.4956 21.8735 10.3853 21.7997 10.2924 21.7067L0.293038 11.7073C0.105409 11.5197 0 11.2652 0 10.9999C0 10.7345 0.105409 10.4801 0.293038 10.2924C0.480667 10.1048 0.735147 9.99939 1.00049 9.99939C1.26584 9.99939 1.52032 10.1048 1.70795 10.2924L10.9999 19.5856L20.2918 10.2924C20.3847 10.1995 20.495 10.1257 20.6164 10.0754C20.7377 10.0251 20.8679 9.99916 20.9993 9.99916C21.1307 9.99916 21.2608 10.0251 21.3822 10.0754C21.5036 10.1257 21.6139 10.1995 21.7067 10.2924ZM10.2924 11.7073C10.3853 11.8003 10.4956 11.8741 10.617 11.9244C10.7384 11.9747 10.8685 12.0006 10.9999 12.0006C11.1313 12.0006 11.2614 11.9747 11.3828 11.9244C11.5042 11.8741 11.6145 11.8003 11.7073 11.7073L21.7067 1.70795C21.8944 1.52032 21.9998 1.26584 21.9998 1.00049C21.9998 0.735147 21.8944 0.480667 21.7067 0.293038C21.5191 0.105409 21.2646 5.23064e-09 20.9993 0C20.7339 -5.23064e-09 20.4794 0.105409 20.2918 0.293038L10.9999 9.58622L1.70795 0.293038C1.52032 0.105409 1.26584 0 1.00049 0C0.735147 0 0.480667 0.105409 0.293038 0.293038C0.105409 0.480667 0 0.735147 0 1.00049C0 1.26584 0.105409 1.52032 0.293038 1.70795L10.2924 11.7073Z"
                fill="#4B3427" />
            </svg>

          </div>
          {%- endif -%}
        </div>
      </div>

  </section>
</div>

{% schema %}
{
"name": "Brandon Hero Banner",
"tag": "section",
"class": "section",
"settings": [
{
"type": "header",
"content": "Loading Screen Prototype"
},
{
"type": "checkbox",
"id": "show_loading_screen",
"label": "Enable Split Loading Screen Animation",
"default": true
},
{
"type": "image_picker",
"id": "loading_top_image",
"label": "Loading Top Image (Optional)"
},
{
"type": "image_picker",
"id": "loading_bottom_image",
"label": "Loading Bottom Image (Optional)"
},
{
"type": "text",
"id": "loading_logo_text",
"label": "Loading Logo Letter/Text",
"default": "B"
},
{
"type": "range",
"id": "loading_duration",
"label": "Loading Animation Speed (Seconds)",
"min": 0.5,
"max": 5.0,
"step": 0.1,
"default": 2.2,
"unit": "s"
},
{
"type": "header",
"content": "Banner Images & Zoom Settings"
},
{
"type": "image_picker",
"id": "desktop_banner_image",
"label": "Desktop Banner Image"
},
{
"type": "image_picker",
"id": "mobile_banner_image",
"label": "Mobile Banner Image"
},
{
"type": "header",
"content": "Optional Dedicated Zoomed Images"
},
{
"type": "image_picker",
"id": "zoomed_desktop_banner_image",
"label": "Zoomed Desktop Banner Image (Optional)"
},
{
"type": "image_picker",
"id": "zoomed_mobile_banner_image",
"label": "Zoomed Mobile Banner Image (Optional)"
},
{
"type": "range",
"id": "zoom_scale",
"label": "Scroll Zoom Scale Factor",
"min": 1.0,
"max": 1.6,
"step": 0.1,
"default": 1.3,
"info": "Controls GSAP zoom animation magnitude when user scrolls down"
},
{
"type": "text",
"id": "banner_image_alt",
"label": "Image Alt Text",
"default": "Brandon Blackwood luxury campaign"
},
{
"type": "header",
"content": "Glassmorphic Preview Card Settings"
},
{
"type": "text",
"id": "subheading",
"label": "Subheading",
"default": "DROPS FRIDAY 7/10 AT 12PM EST"
},
{
"type": "text",
"id": "heading",
"label": "Heading",
"default": "RAFFIA & LINEN"
},
{
"type": "text",
"id": "button_label",
"label": "Button Label",
"default": "PREVIEW NOW"
},
{
"type": "url",
"id": "button_link",
"label": "Button Link"
},
{
"type": "checkbox",
"id": "show_scroll_arrow",
"label": "Show Scroll Down Indicator Arrow",
"default": true
}
],
"presets": [
{
"name": "Brandon Hero Banner",
"settings": {
"show_loading_screen": true,
"loading_logo_text": "B",
"subheading": "DROPS FRIDAY 7/10 AT 12PM EST",
"heading": "RAFFIA & LINEN",
"button_label": "PREVIEW NOW",
"show_scroll_arrow": true
}
}
]
}
{% endschema %}