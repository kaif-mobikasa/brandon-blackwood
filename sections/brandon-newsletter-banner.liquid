{{ 'brandon-newsletter-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ShopifySection-{{ section.id }} .brandon-newsletter-banner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div
  id="ShopifySection-{{ section.id }}"
  class="shopify-section brandon-newsletter-banner-wrapper"
  data-section-id="{{ section.id }}"
  data-section-type="brandon-newsletter-banner"
>
  <section class="brandon-newsletter-banner" aria-label="{{ section.settings.heading | default: 'THE NEXT CHAPTER' | escape }}">
    <div class="brandon-newsletter-banner__main-wrapper">
      {%- if section.settings.bg_image_desktop != blank or section.settings.bg_image_mobile != blank -%}
        <picture class="brandon-newsletter-banner__bg-picture">
          {%- if section.settings.bg_image_mobile != blank -%}
            <source
              media="(max-width: 768px)"
              srcset="{{ section.settings.bg_image_mobile | image_url: width: 1400 }}"
            >
          {%- endif -%}
          {%- if section.settings.bg_image_desktop != blank -%}
            <img
              src="{{ section.settings.bg_image_desktop | image_url: width: 2800 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              width="{{ section.settings.bg_image_desktop.width }}"
              height="{{ section.settings.bg_image_desktop.height }}"
              class="brandon-newsletter-banner__bg-img"
            >
          {%- else -%}
            <img
              src="{{ section.settings.bg_image_mobile | image_url: width: 1400 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              class="brandon-newsletter-banner__bg-img"
            >
          {%- endif -%}
        </picture>
      {%- endif -%}

      <div class="brandon-newsletter-banner__container">
        <div class="brandon-newsletter-banner__card">
          {%- if section.settings.heading != blank -%}
            <h2 class="brandon-newsletter-banner__heading">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="brandon-newsletter-banner__description">
              {{ section.settings.description }}
            </div>
          {%- endif -%}

          {%- form 'customer', class: 'brandon-newsletter-banner__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="brandon-newsletter-banner__field-wrapper">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="brandon-newsletter-banner__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.placeholder_text | default: 'EMAIL ADDRESS' | escape }}"
                required
              >
              <button
                type="submit"
                class="brandon-newsletter-banner__button"
                name="commit"
                id="Subscribe--{{ section.id }}"
                aria-label="{{ section.settings.button_text | default: 'SUBMIT' | escape }}"
              >
                {{ section.settings.button_text | default: 'SUBMIT' | escape }}
              </button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Brandon Newsletter Banner",
  "tag": "section",
  "class": "shopify-section-brandon-newsletter-banner",
  "settings": [
    {
      "type": "header",
      "content": "Background Image Settings"
    },
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "THE NEXT CHAPTER"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A collection shaped by bold silhouettes, refined craftsmanship, and the confidence to stand apart."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Form Input Placeholder",
      "default": "EMAIL ADDRESS"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Text",
      "default": "SUBMIT"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brandon Newsletter Banner"
    }
  ]
}
{% endschema %}
