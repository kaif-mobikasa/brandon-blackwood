{{ 'brandon-uncommon-materials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'brandon-uncommon-materials.js' | asset_url }}" defer="defer"></script>

{%- style -%}
#ShopifySection-{{ section.id }} .brandon-uncommon-materials {
padding-top: {{ section.settings.padding_top }}px;
padding-bottom: {{ section.settings.padding_bottom }}px;
background-color: {{ section.settings.bg_color | default: '#ffffff' }};
}
{%- endstyle -%}

<div id="ShopifySection-{{ section.id }}" class="shopify-section brandon-uncommon-materials-wrapper"
  data-section-id="{{ section.id }}" data-section-type="brandon-uncommon-materials">
  <section class="brandon-uncommon-materials" aria-label="Uncommon Materials Section">
    <div class="brandon-uncommon-materials__container">

      <div class="swiper brandon-uncommon-materials__swiper js-uncommon-materials-swiper">
        <div class="swiper-wrapper brandon-uncommon-materials__swiper-wrapper">

          {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
          <div class="swiper-slide brandon-uncommon-materials__slide-card" {{ block.shopify_attributes }}>
            <div class="brandon-uncommon-materials__card-inner">

              <div class="brandon-uncommon-materials__media">
                {%- if block.settings.image_desktop != blank or block.settings.image_mobile != blank -%}
                <picture class="brandon-uncommon-materials__picture">
                  {%- if block.settings.image_mobile != blank -%}
                  <source media="(max-width: 768px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 1200 }}">
                  {%- endif -%}
                  {%- if block.settings.image_desktop != blank -%}
                  <img src="{{ block.settings.image_desktop | image_url: width: 1600 }}"
                    alt="{{ block.settings.heading | default: block.settings.subtitle | escape }}" loading="lazy"
                    class="brandon-uncommon-materials__img">
                  {%- else -%}
                  <img src="{{ block.settings.image_mobile | image_url: width: 1200 }}"
                    alt="{{ block.settings.heading | default: block.settings.subtitle | escape }}" loading="lazy"
                    class="brandon-uncommon-materials__img">
                  {%- endif -%}
                </picture>
                {%- endif -%}
              </div>

              <div class="brandon-uncommon-materials__mobile-overlay">
                {%- if block.settings.subtitle != blank or block.settings.tagline != blank -%}
                <div class="brandon-uncommon-materials__material-header">
                  {%- if block.settings.icon_svg != blank -%}
                  <div class="brandon-uncommon-materials__icon-wrapper">
                    {{ block.settings.icon_svg }}
                  </div>
                  <div class="brandon-uncommon-materials__divider"></div>
                  {%- endif -%}
                  <div class="brandon-uncommon-materials__material-titles">
                    {%- if block.settings.tagline != blank -%}
                    <span class="brandon-uncommon-materials__mat-title">{{ block.settings.tagline }}</span>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                    <span class="brandon-uncommon-materials__mat-subtitle">{{ block.settings.subtitle }}</span>
                    {%- endif -%}
                  </div>
                </div>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                <h2 class="brandon-uncommon-materials__mobile-heading">
                  {{ block.settings.heading }}
                </h2>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                <div class="brandon-uncommon-materials__mobile-desc">
                  {{ block.settings.description }}
                </div>
                {%- endif -%}

                {%- if forloop.first -%}
                <div class="brandon-uncommon-materials__mobile-dots js-uncommon-materials-dots-mobile"></div>
                {%- endif -%}
              </div>

              <div class="brandon-uncommon-materials__desktop-content">
                {%- if block.settings.subtitle != blank or block.settings.tagline != blank -%}
                <div class="brandon-uncommon-materials__material-header">
                  {%- if block.settings.icon_svg != blank -%}
                  <div class="brandon-uncommon-materials__icon-wrapper">
                    {{ block.settings.icon_svg }}
                  </div>
                  <div class="brandon-uncommon-materials__divider"></div>
                  {%- endif -%}
                  <div class="brandon-uncommon-materials__material-titles">
                    {%- if block.settings.tagline != blank -%}
                    <span class="brandon-uncommon-materials__mat-title">{{ block.settings.tagline }}</span>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                    <span class="brandon-uncommon-materials__mat-subtitle">{{ block.settings.subtitle }}</span>
                    {%- endif -%}
                  </div>
                </div>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                <h2 class="brandon-uncommon-materials__desktop-heading">
                  {{ block.settings.heading }}
                </h2>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                <div class="brandon-uncommon-materials__desktop-desc">
                  {{ block.settings.description }}
                </div>
                {%- endif -%}

                {%- if forloop.first -%}
                <div class="brandon-uncommon-materials__desktop-dots js-uncommon-materials-dots-desktop"></div>
                {%- endif -%}
              </div>

            </div>
          </div>
          {%- endfor -%}
          {%- else -%}
          <div class="swiper-slide brandon-uncommon-materials__slide-card">
            <div class="brandon-uncommon-materials__card-inner">
              <div class="brandon-uncommon-materials__media">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg brandon-uncommon-materials__img' }}
              </div>
              <div class="brandon-uncommon-materials__desktop-content">
                <h2 class="brandon-uncommon-materials__desktop-heading">THE ART OF UNCOMMON MATERIALS</h2>
                <div class="brandon-uncommon-materials__desktop-desc">
                  Every Luna Bag is defined by the unexpected combination of textures, finishes and details. Discover
                  the materials that give this piece its distinctive character.
                </div>
                <div class="brandon-uncommon-materials__desktop-dots js-uncommon-materials-dots-desktop"></div>
              </div>
            </div>
          </div>

          <div class="swiper-slide brandon-uncommon-materials__slide-card">
            <div class="brandon-uncommon-materials__card-inner">
              <div class="brandon-uncommon-materials__media">
                {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg brandon-uncommon-materials__img' }}
              </div>
              <div class="brandon-uncommon-materials__desktop-content">
                <div class="brandon-uncommon-materials__material-header">
                  <div class="brandon-uncommon-materials__icon-wrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4 8H20M4 16H20M8 4V20M16 4V20" stroke="currentColor" stroke-width="1.5"
                        stroke-linecap="round" />
                    </svg>
                  </div>
                  <div class="brandon-uncommon-materials__divider"></div>
                  <div class="brandon-uncommon-materials__material-titles">
                    <span class="brandon-uncommon-materials__mat-title">Main</span>
                    <span class="brandon-uncommon-materials__mat-subtitle">Straw material + Linen</span>
                  </div>
                </div>
                <div class="brandon-uncommon-materials__desktop-desc">
                  Natural straw and textured linen come together to create a distinctive aesthetic. The straw material
                  adds an expressive fringed edge while linen gives the silhouette its refined structure.
                </div>
              </div>
            </div>
          </div>
          {%- endif -%}

        </div>
      </div>

      <div class="brandon-uncommon-materials__bottom-line"></div>
    </div>
  </section>
</div>


{% schema %}
{
"name": "Uncommon Materials",
"tag": "section",
"class": "shopify-section-brandon-uncommon-materials",
"settings": [
{
"type": "color",
"id": "bg_color",
"label": "Background Color",
"default": "#ffffff"
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "Top Padding",
"default": 40
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "Bottom Padding",
"default": 40
}
],
"blocks": [
{
"type": "card",
"name": "Material Card",
"settings": [
{
"type": "image_picker",
"id": "image_desktop",
"label": "Card Image (Desktop)"
},
{
"type": "image_picker",
"id": "image_mobile",
"label": "Card Image (Mobile)"
},
{
"type": "text",
"id": "heading",
"label": "Main Heading"
},
{
"type": "textarea",
"id": "description",
"label": "Description"
},
{
"type": "html",
"id": "icon_svg",
"label": "Material Icon SVG Code (Optional)"
},
{
"type": "text",
"id": "tagline",
"label": "Small Tagline / Label (Optional)"
},
{
"type": "text",
"id": "subtitle",
"label": "Subtitle (Optional)"
},
{
"type": "url",
"id": "link",
"label": "Card Link"
}
]
}
],
"presets": [
    {
      "name": "Uncommon Materials",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "THE ART OF UNCOMMON MATERIALS",
            "description": "Every Luna Bag is defined by the unexpected combination of textures, finishes and details. Discover the materials that give this piece its distinctive character.",
            "tagline": "",
            "subtitle": ""
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "",
            "description": "Natural straw and textured linen come together to create a distinctive aesthetic. The straw material adds an expressive fringed edge while linen gives the silhouette its refined structure.",
            "icon_svg": "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 8H20M4 16H20M8 4V20M16 4V20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" /></svg>",
            "tagline": "Main",
            "subtitle": "Straw material + Linen"
          }
        }
      ]
    }
  ]
}
{% endschema %}